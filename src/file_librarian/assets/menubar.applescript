use AppleScript version "2.4"
use framework "Foundation"
use framework "AppKit"
use scripting additions

-- flib's menu bar item (#116, ADR 0004), generated by flib (menubar.py) when it was
-- built: the paths and the actions below are fixed. state.json is untrusted data,
-- checked key by key; nothing in it is ever run or chooses what runs. Every handler
-- swallows its errors, as an error in an applet would show a dialog.

property idleSeconds : @IDLE@
property maxStateBytes : @MAX_BYTES@
property maxText : @MAX_TEXT@
property maxCount : @MAX_COUNT@
property stateVersion : @VERSION@
-- Globals, not properties: an applet would try to save changed properties into itself.
global statusItem, theMenu, lineItem, nextItem, reviewItem, dueItem, organizeItem
global lastStamp, tasks

on stateDir()
	return @STATE_DIR@
end stateDir

on flibProgram()
	return @PROGRAM@
end flibProgram

on flibArguments(args)
	return (@PREFIX@ & args) & {"--config", @CONFIG@}
end flibArguments

on knownPoses()
	return @POSES@
end knownPoses

on knownKeys()
	return @KEYS@
end knownKeys

on run
	try
		my setUp()
	on error
		quit
	end try
end run

on setUp()
	set ca to current application
	set lastStamp to missing value
	set tasks to {}
	set statusItem to ca's NSStatusBar's systemStatusBar()'s statusItemWithLength:(ca's NSVariableStatusItemLength)
	statusItem's setAutosaveName:@AUTOSAVE@
	statusItem's |button|()'s setImagePosition:(ca's NSImageLeading)
	set theMenu to ca's NSMenu's alloc()'s init()
	theMenu's setAutoenablesItems:false
	theMenu's setDelegate:me
	set lineItem to my addItem(@DEFAULT_LINE@, missing value)
	lineItem's setEnabled:false
	set nextItem to my addItem("", missing value)
	nextItem's setEnabled:false
	nextItem's setHidden:true
	theMenu's addItem:(ca's NSMenuItem's separatorItem())
	my addItem(@TITLE_STATUS@, "openStatus:")
	set reviewItem to my addItem(@TITLE_REVIEW@, "openReview:")
	reviewItem's setHidden:true
	set dueItem to my addItem(@TITLE_DUE@, "openDue:")
	dueItem's setHidden:true
	theMenu's addItem:(ca's NSMenuItem's separatorItem())
	set organizeItem to my addItem(@TITLE_ORGANIZE@, "organize:")
	my addItem(@TITLE_SETTINGS@, "openSettings:")
	theMenu's addItem:(ca's NSMenuItem's separatorItem())
	my addItem("Quit", "quitApp:")
	statusItem's setMenu:theMenu
	my refresh(true)
end setUp

on addItem(title, selectorName)
	set entry to current application's NSMenuItem's alloc()'s initWithTitle:title action:selectorName keyEquivalent:""
	if selectorName is not missing value then entry's setTarget:me
	theMenu's addItem:entry
	return entry
end addItem

on idle
	try
		my refresh(false)
		my forgetFinished()
	end try
	return idleSeconds
end idle

-- `open -g <app>` while it runs lands here: flib's nudge after it wrote state.json.
on reopen
	try
		my refresh(true)
	end try
end reopen

on menuWillOpen:aMenu
	try
		my refresh(false)
	end try
end menuWillOpen:

on refresh(force)
	set ca to current application
	set statePath to my stateDir() & "/state.json"
	set attrs to ca's NSFileManager's defaultManager()'s attributesOfItemAtPath:statePath |error|:(missing value)
	set stamp to "none"
	if attrs is not missing value then set stamp to (((attrs's fileModificationDate()'s timeIntervalSince1970()) as real) as text) & "/" & ((attrs's fileSize()) as text)
	if (not force) and stamp = lastStamp then return
	set lastStamp to stamp
	set clean to my readState(statePath)
	my show(clean)
	my writeSeen(clean)
end refresh

-- state.json, checked: a dictionary of known keys only, each of the right kind and
-- size, or else the defaults. Returns a dictionary with every key.
on readState(statePath)
	set ca to current application
	set clean to ca's NSMutableDictionary's dictionary()
	clean's setObject:stateVersion forKey:"version"
	clean's setObject:@DEFAULT_POSE@ forKey:"pose"
	clean's setObject:@DEFAULT_LINE@ forKey:"line"
	clean's setObject:"" forKey:"next"
	clean's setObject:0 forKey:"count"
	clean's setObject:0 forKey:"review"
	clean's setObject:0 forKey:"due"
	clean's setObject:false forKey:"running"
	set fm to ca's NSFileManager's defaultManager()
	set attrs to fm's attributesOfItemAtPath:statePath |error|:(missing value)
	if attrs is missing value then return clean
	if (attrs's fileType()) as text is not "NSFileTypeRegular" then return clean
	if ((attrs's fileSize()) as real) > maxStateBytes then return clean
	set theData to ca's NSData's dataWithContentsOfFile:statePath
	if theData is missing value then return clean
	if ((theData's |length|()) as real) > maxStateBytes then return clean
	set parsed to ca's NSJSONSerialization's JSONObjectWithData:theData options:0 |error|:(missing value)
	if parsed is missing value then return clean
	if not ((parsed's isKindOfClass:(ca's NSDictionary)) as boolean) then return clean
	set keys to (parsed's allKeys()) as list
	considering case
		repeat with k in keys
			if (my knownKeys()) does not contain (contents of k) then return clean
		end repeat
	end considering
	if my countValue(parsed's objectForKey:"version") is not stateVersion then return clean
	set p to my textValue(parsed's objectForKey:"pose")
	considering case
		if p is not missing value and (my knownPoses()) contains p then clean's setObject:p forKey:"pose"
	end considering
	set l to my textValue(parsed's objectForKey:"line")
	if l is not missing value and l is not "" then clean's setObject:l forKey:"line"
	set n to my textValue(parsed's objectForKey:"next")
	if n is not missing value then clean's setObject:n forKey:"next"
	repeat with k in {"count", "review", "due"}
		set c to my countValue(parsed's objectForKey:(contents of k))
		if c is not missing value then clean's setObject:c forKey:(contents of k)
	end repeat
	set r to parsed's objectForKey:"running"
	if my isBoolean(r) then clean's setObject:(r as boolean) forKey:"running"
	return clean
end readState

on isBoolean(value)
	set ca to current application
	if value is missing value then return false
	return (value's isKindOfClass:((ca's NSNumber's numberWithBool:true)'s |class|())) as boolean
end isBoolean

-- A whole number from 0 to maxCount (not a boolean), or missing value.
on countValue(value)
	set ca to current application
	if value is missing value then return missing value
	if not ((value's isKindOfClass:(ca's NSNumber)) as boolean) then return missing value
	if my isBoolean(value) then return missing value
	set d to (value's doubleValue()) as real
	if d < 0 or d > maxCount then return missing value
	set i to (value's integerValue()) as integer
	if (i as real) is not d then return missing value
	return i
end countValue

-- A string of at most maxText characters with no control, format or line-break
-- character, or missing value.
on textValue(value)
	set ca to current application
	if value is missing value then return missing value
	if not ((value's isKindOfClass:(ca's NSString)) as boolean) then return missing value
	if ((value's |length|()) as integer) > maxText then return missing value
	set found to value's rangeOfString:@TEXT_PATTERN@ options:(ca's NSRegularExpressionSearch)
	if (|length| of found) is not 0 then return missing value
	return value as text
end textValue

on show(clean)
	set ca to current application
	set pose to (clean's objectForKey:"pose") as text
	set iconPath to ca's NSBundle's mainBundle()'s pathForResource:pose ofType:"svg"
	set img to missing value
	if iconPath is not missing value then set img to ca's NSImage's alloc()'s initWithContentsOfFile:iconPath
	set btn to statusItem's |button|()
	set c to (clean's objectForKey:"count") as integer
	if img is not missing value then
		img's setTemplate:true
		img's setSize:{18, 18}
		btn's setImage:img
		if c > 0 then
			btn's setTitle:(c as text)
		else
			btn's setTitle:""
		end if
	else
		btn's setImage:(missing value)
		btn's setTitle:"flib"
	end if
	set lineText to (clean's objectForKey:"line") as text
	btn's setToolTip:("file-librarian: " & lineText)
	lineItem's setTitle:lineText
	set nextText to (clean's objectForKey:"next") as text
	nextItem's setTitle:nextText
	nextItem's setHidden:(nextText is "")
	set r to (clean's objectForKey:"review") as integer
	reviewItem's setTitle:(@TITLE_REVIEW@ & " (" & r & ")")
	reviewItem's setHidden:(r is 0)
	set d to (clean's objectForKey:"due") as integer
	dueItem's setTitle:(@TITLE_DUE@ & " (" & d & ")")
	dueItem's setHidden:(d is 0)
	-- While a run is going on, Organize now is greyed out: the first line says so.
	organizeItem's setEnabled:(not ((clean's objectForKey:"running") as boolean))
end show

-- What it shows and its pid, for `flib doctor`: counts only, like state.json.
on writeSeen(clean)
	set ca to current application
	set report to ca's NSMutableDictionary's dictionaryWithDictionary:clean
	report's setObject:(ca's NSProcessInfo's processInfo()'s processIdentifier()) forKey:"pid"
	set json to ca's NSJSONSerialization's dataWithJSONObject:report options:0 |error|:(missing value)
	if json is not missing value then json's writeToFile:(my stateDir() & "/seen.json") atomically:true
end writeSeen

-- For tests: what readState makes of a file, as JSON text.
on stateJSON(statePath)
	set ca to current application
	set json to ca's NSJSONSerialization's dataWithJSONObject:(my readState(statePath)) options:0 |error|:(missing value)
	return (ca's NSString's alloc()'s initWithData:json encoding:(ca's NSUTF8StringEncoding)) as text
end stateJSON

-- The one program a click runs, fixed when the app was built, with the fixed words
-- of one action: no shell, no PATH, output to /dev/null. Never waits for it.
on launchFlib(args)
	set ca to current application
	set program to my flibProgram()
	if not ((ca's NSFileManager's defaultManager()'s isExecutableFileAtPath:program) as boolean) then return
	set task to ca's NSTask's alloc()'s init()
	task's setExecutableURL:(ca's NSURL's fileURLWithPath:program)
	task's setArguments:(my flibArguments(args))
	task's setCurrentDirectoryURL:(ca's NSURL's fileURLWithPath:"/")
	set nothing to ca's NSFileHandle's fileHandleWithNullDevice()
	task's setStandardInput:nothing
	task's setStandardOutput:nothing
	task's setStandardError:nothing
	if (task's launchAndReturnError:(missing value)) as boolean then my keep(task)
end launchFlib

-- Started tasks are kept until they end, so each is reaped; outside the applet (a
-- test loading this script) the list does not exist yet.
on keep(task)
	try
		set end of tasks to task
	on error
		set tasks to {task}
	end try
end keep

on forgetFinished()
	set still to {}
	repeat with t in tasks
		if ((contents of t)'s isRunning()) as boolean then set end of still to contents of t
	end repeat
	set tasks to still
end forgetFinished

@HANDLERS@
on quitApp:sender
	quit
end quitApp:

on quit
	try
		current application's NSStatusBar's systemStatusBar()'s removeStatusItem:statusItem
	end try
	continue quit
end quit
